# Optional. The app already points at Firebase project willowpoint-ff851 (see src/lib/firebase.js).
# Copy to .env.local to override.

# Run on the local snapshot in src/data.js instead of Firestore (handy for design work offline):
# VITE_FIREBASE_DISABLED=true

# Point at a different Firebase project:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
