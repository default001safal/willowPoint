# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These web config values are not secrets (they ship to every browser), but keep .env.local out of git anyway.
# Leave them empty to run the app on the local snapshot in src/data.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=willowpoint-ff851.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=willowpoint-ff851
VITE_FIREBASE_STORAGE_BUCKET=willowpoint-ff851.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
