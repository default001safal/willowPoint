# The production Firebase project is configured in src/lib/firebase.js.
# Optional local overrides for a different Firebase project:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional Cue proxy override. No provider secret belongs in client environment files.
# VITE_CUE_PROXY_URL=
