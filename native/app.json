{
  "expo": {
    "name": "willowPoint",
    "slug": "willowpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "willowpoint",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0C",
    "splash": {
      "backgroundColor": "#0C0C0C",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.willowpoint.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.willowpoint.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "googleClientId": null,
      "eas": {
        "projectId": "9e09bc0c-df15-4a7d-8c61-811025dbb8b3"
      }
    },
    "jsEngine": "jsc",
    "owner": "willowpoint"
  }
}
